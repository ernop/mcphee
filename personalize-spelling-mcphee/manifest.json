{
  "manifest_version": 3,
  "name": "personalized-spelling",
  "version": "0.2.1",
  "description": "Apply personalized-spelling to form inputs you allow. Only those forms are seen or checked.",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "personalize-spelling-mcphee@fuseki.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/typo/typo.min.js", "mcphee.js", "editable.js", "content.js"],
      "css": ["mcphee.css", "page.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mcphee.css",
        "vendor/typo/en_US.aff",
        "vendor/typo/en_US.dic",
        "vendor/typo/en_US_2026.aff",
        "vendor/typo/en_US_2026.dic",
        "vendor/wordfreq/en-30k.txt"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "personalized-spelling"
  }
}
